# ============================================================
# DarkTrace Nexus — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values for production.
# NEVER commit .env to version control.
# ============================================================

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql+asyncpg://darktrace:YOUR_PASSWORD@YOUR_HOST:5432/darktrace_nexus
POSTGRES_USER=darktrace
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=darktrace_nexus

# ── Neo4j (optional, graph features degrade gracefully) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Redis (optional, currently unused) ──
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ──
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]
ENABLE_DOCS=false
ENABLE_DEMO_AUTH=false
ENVIRONMENT=production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── ML (optional) ──
ML_MODEL_PATH=/app/ml/models
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ── Frontend (public, exposed to browser) ──
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
